{
  "name": "linuxdo-theme-suite",
  "version": "1.0.0",
  "description": "适用于 LINUX DO 的本地油猴主题、动态背景与随机英雄工具。",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kourou25/linuxdo-theme-suite.git"
  },
  "homepage": "https://github.com/kourou25/linuxdo-theme-suite",
  "scripts": {
    "assets": "pwsh -NoProfile -File scripts/encode-assets.ps1",
    "hero-assets": "pwsh -NoProfile -File scripts/prepare-hero-assets.ps1",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/runtime.test.mjs tests/hero-draw.test.mjs tests/suite-pack.test.mjs tests/build.test.mjs",
    "check": "node --check dist/linuxdo-theme-suite.user.js && node --check dist/linuxdo-theme-suite-core.user.js"
  },
  "engines": {
    "node": ">=24"
  }
}
